APP_ENV=development
APP_PORT=8080
APP_NAME=diuk-backend

# Supabase PostgreSQL connection string. Use the direct connection or the
# session pooler for migrations; never commit the real value.
DATABASE_URL=postgresql://user:password@localhost:5432/diuk



REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=5
REDIS_QUEUE_PREFIX=diuk

# api | worker | all
APP_MODE=all
WORKER_AI_CONCURRENCY=2
WORKER_DELIVERY_CONCURRENCY=2
AI_WORKER_TIMEOUT_SECONDS=90
DELIVERY_WORKER_TIMEOUT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_CAP_SECONDS=120
JOB_DLQ_RETENTION_DAYS=7
OUTBOX_POLL_SECONDS=2
JOB_CLAIM_IDLE_SECONDS=60

# Optional. Set to run Redis stream integration tests.
# TEST_REDIS_URL=redis://localhost:6379

# Supabase project URL. The backend derives the JWKS endpoint and JWT issuer
# from this value. Do not put a JWT secret here.
SUPABASE_URL=https://your-project.supabase.co

# Backend-only service role key for Supabase Storage. Never commit the real
# value, never send it to Next.js, and never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket for menu images. Create it in the Supabase dashboard
# as a private bucket; the API does not create it on startup.
SUPABASE_STORAGE_MENU_BUCKET=diuk-menu-images

# Comma-separated list of origins allowed to call the API.
# Required in production. Wildcard * is rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# HTTP timeouts and payload bounds (seconds / bytes).
HTTP_READ_HEADER_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_WRITE_TIMEOUT_SECONDS=180
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_JSON_BYTES=1048576
HTTP_SHUTDOWN_TIMEOUT_SECONDS=15
# Comma-separated CIDRs trusted for X-Forwarded-For. Empty = do not trust proxies.
HTTP_TRUSTED_PROXIES=
WEBHOOK_MAX_BODY_BYTES=1048576

# PostgreSQL pool. Keep small behind a Supabase pooler.
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_SECONDS=3600
DB_MAX_CONN_IDLE_TIME_SECONDS=1800
DB_HEALTH_CHECK_PERIOD_SECONDS=60

# In-process rate limits. Fail-open; Redis is not required.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK_PER_MIN=180
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CAMPAIGN_PER_MIN=10

# Development seeder (cmd/seed). The Auth user must already exist in Supabase.
SEED_AUTH_USER_ID=
SEED_USER_EMAIL=

# Optional. When set, the repository tests run against this migrated database
# instead of being skipped.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/diuk_test

# Optional. Set to true to run live Supabase Storage tests. They also need
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# TEST_STORAGE_ENABLED=true

# Optional AI provider settings. Keys are never stored in PostgreSQL.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# Optional. Set true to run a live LLM provider test. Default tests stay offline.
# TEST_AI_LIVE=false

# Knowledge Base + RAG (JOB 14). Embeddings stay disabled unless explicitly enabled
# so the API and conversations still boot without an embedding key.
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=64
AI_EMBEDDING_TIMEOUT_SECONDS=30
# Optional. Falls back to AI_API_KEY when empty.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=

KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.35
KNOWLEDGE_MAX_FILE_SIZE_MB=10
WORKER_KNOWLEDGE_CONCURRENCY=1
KNOWLEDGE_WORKER_TIMEOUT_SECONDS=180

# Optional. Set 1 to run the 000011↔000012 migrate cycle against TEST_DATABASE_URL.
# TEST_KNOWLEDGE_MIGRATE=0

# Automation Engine (JOB 15). CRUD still works when disabled.
AUTOMATION_ENABLED=true
AUTOMATION_SCHEDULER_INTERVAL=30
AUTOMATION_MAX_RUNS_PER_TICK=50
AUTOMATION_DEFAULT_INACTIVITY_MINUTES=120
WORKER_AUTOMATION_CONCURRENCY=2
AUTOMATION_WORKER_TIMEOUT_SECONDS=60

# Optional. Set 1 to run the 000012↔000013 migrate cycle against TEST_DATABASE_URL.
# TEST_AUTOMATION_MIGRATE=0

# Optional. Set 1 to run the 000013↔000014 migrate cycle against TEST_DATABASE_URL.
# TEST_HANDOVER_MIGRATE=0

# Optional. Set 1 to run the 000014↔000015 migrate cycle against TEST_DATABASE_URL.
# TEST_ANALYTICS_MIGRATE=0

# Broadcast campaigns (JOB 18). Dispatch reuses MESSAGE_DELIVERY.
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_DISPATCH_INTERVAL_MS=200
CAMPAIGN_SCHEDULER_INTERVAL=30
CAMPAIGN_MAX_STARTS_PER_TICK=20
CAMPAIGN_MAX_CONCURRENCY=2
CAMPAIGN_WORKER_TIMEOUT_SECONDS=60

# Optional. Set 1 to run the 000015↔000016 migrate cycle against TEST_DATABASE_URL.
# TEST_CAMPAIGN_MIGRATE=0

# Optional. Set 1 to run the 000016↔000017 migrate cycle against TEST_DATABASE_URL.
# TEST_USAGE_MIGRATE=0

# Optional. Set 1 to run the 000018↔000019 migrate cycle against TEST_DATABASE_URL.
# TEST_PAYMENT_MIGRATE=0

# Optional. Set 1 to run the 000019↔000020 migrate cycle against TEST_DATABASE_URL.
# TEST_CALENDAR_MIGRATE=0

# Optional. Set 1 to run the 000020↔000021 migrate cycle against TEST_DATABASE_URL.
# TEST_REVENUE_MIGRATE=0

# WhatsApp Cloud API (JOB 12). Tokens stay in env; they are never written to
# PostgreSQL or returned by the channel management API.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_BASE_URL=https://graph.facebook.com
META_WHATSAPP_TIMEOUT_SECONDS=10

# Optional. Set true to run one live WhatsApp send test. Also needs
# META_WHATSAPP_PHONE_NUMBER_ID and META_WHATSAPP_TO. Default tests stay offline.
# TEST_WHATSAPP_LIVE=false
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_TO=
